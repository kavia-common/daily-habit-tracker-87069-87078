# Supabase environment
# IMPORTANT: These are required for the app to communicate with Supabase from the browser.
# Obtain values from your Supabase project settings:
# - NEXT_PUBLIC_SUPABASE_URL: Project URL (Settings > API)
# - NEXT_PUBLIC_SUPABASE_KEY: anon public key (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Optional: Site URL for dynamic redirects (used by auth later)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
