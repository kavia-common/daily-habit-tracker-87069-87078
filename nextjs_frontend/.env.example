# Copy this file to .env.local and fill with your Supabase project settings

# Supabase public URL and anon key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key

# Optional: Site URL for redirect helpers (used in some flows)
# If deploying to Vercel, NEXT_PUBLIC_VERCEL_URL is auto-provided
NEXT_PUBLIC_SITE_URL=http://localhost:3000
