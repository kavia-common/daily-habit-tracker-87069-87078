# PUBLIC_INTERFACE
# Example environment variables for the Next.js frontend.
# Copy to `.env.local` or `.env` and fill with your Supabase project values.

# Supabase (required for database)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_KEY="YOUR_ANON_PUBLIC_KEY"

# Clerk note:
# Clerk is configured via its dashboard and Next.js middleware/components in this repo.
# If you add custom Clerk envs (e.g., NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY),
# ensure they are added to your environment. This repo currently relies on middleware config.
